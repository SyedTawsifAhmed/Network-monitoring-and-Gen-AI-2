# Copy this file to .env or export the variables in your shell.
DATASET_PATH=all_samples_with_metadata.jsonl
MODEL_PATH=models/Qwen3-8B-Q4_K_M.gguf
CACHE_DIR=.rag_cache

# Start conservatively on a 4-vCPU VM.
LLAMA_THREADS=3
LLAMA_BATCH_THREADS=3
EMBED_THREADS=1
LLAMA_BATCH_SIZE=128
CONTEXT_SIZE=4096
MAX_OUTPUT_TOKENS=220

TOP_K=3
CANDIDATE_K=30
MIN_EXACT_OPERATION_EXAMPLES=2
GPU_LAYERS=0
